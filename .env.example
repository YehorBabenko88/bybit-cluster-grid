ROLE=worker
COORDINATOR_URL=http://127.0.0.1:8787
# Transitional coordinator/admin secret only. Workers should use per-node enrollment credentials.
GRID_SHARED_TOKEN=
ENROLLMENT_TOKEN=
POSTGRES_DSN=postgresql://cluster_grid:CHANGE_ME@127.0.0.1:55432/bybit_cluster_grid
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_REST_URL=https://api.bybit.com
RESOURCE_CPU_LIMIT=75
RESOURCE_RAM_LIMIT=78
RESOURCE_DISK_FREE_GB=25
RESOURCE_RESERVE_CORES=2
HEARTBEAT_SECONDS=10
REBALANCE_SECONDS=30
CLUSTER_INTERVAL_SECONDS=60
MICROSTRUCTURE_SNAPSHOT_MS=250
MICRO_TAPE_BUCKET_MS=250
MICRO_RAW_CAPTURE_ENABLED=true
MICRO_RAW_ORDERBOOK_BATCH_MS=250
MICRO_MAX_SYMBOLS_PER_NODE=8
MICRO_LARGE_TRADE_MULT=5.0
MICRO_LARGE_TRADE_EMA_ALPHA=0.05
RETENTION_MICRO_RAW_DAYS=30
RETENTION_MICRO_SAMPLES_DAYS=365
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
OFFLINE_WARN_HOURS=24
QUARANTINE_DAYS=3
DECOMMISSION_DAYS=7

# Continuous live microstructure ML sample lifecycle (CONTROL)
MICRO_ML_LIFECYCLE_ENABLED=true
MICRO_ML_LIFECYCLE_SECONDS=60
MICRO_ML_HORIZONS_SECONDS=60,300,900

# Optional distributed Strattester compute capability on this node
STRATTESTER_ENABLED=false
STRATTESTER_VERSION=
STRATTESTER_COMMAND=
CONTENT_CACHE_ROOT=C:/ProgramData/BybitClusterGrid/content-cache
ARCHIVE_COMPUTE_ENABLED=false
WORKER_PROCESS_MEMORY_MB=2048
WORKER_CHILD_MEMORY_MB=4096
CONTENT_CACHE_MAX_GB=20
CONTENT_CACHE_TTL_DAYS=14
WORKSPACE_TTL_HOURS=24
MAINTENANCE_INTERVAL_MINUTES=15
